#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <Adafruit_AHTX0.h>
#include <Adafruit_BMP280.h>

// === OLED CONFIG ===
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET -1
#define SCREEN_ADDRESS 0x3C

// === OBJECTS ===
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);
Adafruit_AHTX0 aht;
Adafruit_BMP280 bmp;

void setup() {
  Serial.begin(115200);
  Serial.println(F("Starting sensors..."));

  // === OLED INIT ===
  if (!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
    Serial.println(F("OLED fail"));
    while (1);
  }
  display.clearDisplay();
  display.display();

  // === AHT20 INIT ===
  if (!aht.begin()) {
    Serial.println(F("AHT20 not found"));
    while (1);
  }
  Serial.println(F("AHT20 ready"));

  // === BMP280 INIT ===
  if (!bmp.begin(0x76)) {
    if (!bmp.begin(0x77)) {
      Serial.println(F("BMP280 not found"));
      while (1);
    }
  }
  Serial.println(F("BMP280 ready"));
}

void loop() {
  // === READ SENSOR VALUES ===
  sensors_event_t humidity, temp;
  aht.getEvent(&humidity, &temp);                  // AHT20 temp & RH
  float t1 = temp.temperature;                     // °C
  float t2 = bmp.readTemperature();                // BMP280 temp °C
  float avgTemp = (t1 + t2) / 2.0;                 // Average temperature

  float pressurePa = bmp.readPressure();           // Pa
  float pressureAtm = pressurePa / 101325.0;       // atm

  // === OLED DISPLAY ===
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);

  display.setCursor(0, 0);
  display.println("ENV SENSOR READOUT");

  display.setCursor(0, 12);
  display.print("Avg Temp: ");
  display.print(avgTemp, 1);
  display.println(" C");

  display.setCursor(0, 22);
  display.print("Humidity: ");
  display.print(humidity.relative_humidity, 1);
  display.println(" %");

  display.setCursor(0, 32);
  display.print("Pressure: ");
  display.print(pressurePa, 0);
  display.println(" Pa");

  display.setCursor(0, 42);
  display.print("           ");
  display.print(pressureAtm, 3);
  display.println(" atm");

  display.display();

  // === SERIAL DEBUG ===
  Serial.print("Temp AHT20: ");
  Serial.print(t1);
  Serial.print(" C | BMP280: ");
  Serial.print(t2);
  Serial.print(" C | Avg: ");
  Serial.println(avgTemp);

  Serial.print("Humidity: ");
  Serial.print(humidity.relative_humidity);
  Serial.println(" %");

  Serial.print("Pressure: ");
  Serial.print(pressurePa);
  Serial.print(" Pa | ");
  Serial.print(pressureAtm, 4);
  Serial.println(" atm");

  delay(1000); // Wait 1 second
}
