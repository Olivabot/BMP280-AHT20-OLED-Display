#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <Adafruit_AHTX0.h>
#include <Adafruit_BMP280.h>

// OLED display width and height
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET -1
#define SCREEN_ADDRESS 0x3C  // I2C address for the OLED

// Create objects for the sensors
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);  // OLED object
Adafruit_AHTX0 aht;  // AHT20 sensor object
Adafruit_BMP280 bmp;  // BMP280 sensor object

void setup() {
  Serial.begin(115200);
  Serial.println(F("BMP280 + AHT20 + OLED Test"));

  // Initialize the OLED display
  if (!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
    Serial.println(F("SSD1306 allocation failed"));
    while (1);  // Stop if OLED can't be initialized
  }
  display.clearDisplay();  // Clear the display
  display.display();

  // Initialize the AHT20 sensor
  if (!aht.begin()) {
    Serial.println(F("AHT20 not found!"));
    while (1);  // Stop if AHT20 can't be initialized
  }
  Serial.println(F("AHT20 found and initialized"));

  // Initialize the BMP280 sensor (try address 0x76 first, then 0x77)
  if (!bmp.begin(0x76)) {
    if (!bmp.begin(0x77)) {
      Serial.println(F("BMP280 not found!"));
      while (1);  // Stop if BMP280 can't be initialized
    }
  }
  Serial.println(F("BMP280 found and initialized"));
}

void loop() {
  // Read temperature and humidity from AHT20
  sensors_event_t humidity, temp;
  aht.getEvent(&humidity, &temp);  // Get the temperature and humidity events

  // Read temperature and pressure from BMP280
  float bmpTemperature = bmp.readTemperature();
  float pressure = bmp.readPressure() / 100.0F;  // Convert pressure from Pa to hPa
  float pressureAtm = pressure / 1013.25;  // Convert hPa to atm (1 atm = 1013.25 hPa)

  // Display the values on the OLED
  display.clearDisplay();  // Clear the OLED display
  display.setTextSize(1);  // Set text size
  display.setTextColor(SSD1306_WHITE);  // Set text color

  // Display humidity from AHT20
  display.setCursor(0, 0);
  display.print("Humidity: ");
  display.print(humidity.relative_humidity);
  display.println(" %");

  // Display temperature from AHT20
  display.setCursor(0, 10);
  display.print("Temp(AHT20): ");
  display.print(temp.temperature);
  display.println(" C");

  // Display temperature from BMP280
  display.setCursor(0, 20);
  display.print("Temp(BMP280): ");
  display.print(bmpTemperature);
  display.println(" C");

  // Display pressure in atm from BMP280
  display.setCursor(0, 30);
  display.print("Pressure: ");
  display.print(pressureAtm);
  display.println(" atm");

    // Display pressure from BMP280
  display.setCursor(0, 40);
  display.print("Pressure: ");
  display.print(pressure);
  display.println(" hPa");

  // Update the display with new data
  display.display();

  // Print the same information to the Serial Monitor for debugging
  Serial.print("Temp (AHT20): ");
  Serial.print(temp.temperature);
  Serial.println(" C");

  Serial.print("Humidity: ");
  Serial.print(humidity.relative_humidity);
  Serial.println(" %");

  Serial.print("Temp (BMP280): ");
  Serial.print(bmpTemperature);
  Serial.println(" C");

  Serial.print("Pressure: ");
  Serial.print(pressureAtm);
  Serial.println(" atm; ");
  Serial.print(pressure);
  Serial.println(" hPa");

  delay(1000);  // Wait for 2 seconds before the next reading
}
